# GitQuery environment template
#
# Copy to .env and fill in. Never commit the real values.
#
# Spring Boot maps UPPER_SNAKE_CASE environment variables onto dotted
# properties, so APP_FRONTEND_URL becomes app.frontend-url and
# SPRING_DATASOURCE_URL becomes spring.datasource.url.

# ---------------------------------------------------------------- database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/devpilot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------- app
# Where OAuth redirects land after a successful GitHub login.
APP_FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API with credentials.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Encrypts GitHub access tokens at rest. REQUIRED.
# Generate with: openssl rand -base64 32
APP_TOKEN_ENCRYPTOR_PASSWORD=
APP_TOKEN_ENCRYPTOR_SALT=

# ------------------------------------------------------------------ indexing
# Files larger than this are skipped (bytes). Default 102400 (100 KiB).
APP_INDEXING_MAX_FILE_BYTES=102400

# Chunk size in characters before conversion to tokens. Default 800.
APP_INDEXING_CHUNK_SIZE=800

# Delay between GitHub API calls, in milliseconds. Default 50.
APP_GITHUB_API_DELAY_MS=50

# ------------------------------------------------------------ github oauth
# Callback URL to register on the OAuth App:
#   http://localhost:8080/login/oauth2/code/github
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_SECRET=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_SCOPE=read:user,repo

# ------------------------------------------------------------------ openai
SPRING_AI_OPENAI_API_KEY=

# --------------------------------------------------------------- pgvector
# Creates the vector_store table on startup if it does not exist.
SPRING_AI_VECTORSTORE_PGVECTOR_INITIALIZE_SCHEMA=true
# The vector dimensions must match your embedding model's output.
SPRING_AI_VECTORSTORE_PGVECTOR_DIMENSIONS=

# ---------------------------------------------------------------- frontend
# Base URL the browser uses for API calls. Must be reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
