# GitQuery environment template
#
# Copy to .env and fill in. Never commit the real values.
#
# Spring Boot maps UPPER_SNAKE_CASE environment variables onto dotted
# properties, so APP_FRONTEND_URL becomes app.frontend-url and
# SPRING_DATASOURCE_URL becomes spring.datasource.url.

# ---------------------------------------------------------------- database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/gitquery
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------- app
# Where OAuth redirects land after a successful GitHub login.
APP_FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API with credentials.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Encrypts GitHub access tokens at rest. REQUIRED.
# Generate with: openssl rand -base64 32
APP_TOKEN_ENCRYPTOR_PASSWORD=
APP_TOKEN_ENCRYPTOR_SALT=

# ------------------------------------------------------------------ indexing
# Files larger than this are skipped (bytes). Default 102400 (100 KiB).
APP_INDEXING_MAX_FILE_BYTES=102400

# Chunk size in characters before conversion to tokens. Default 800.
APP_INDEXING_CHUNK_SIZE=800

# Delay between GitHub API calls, in milliseconds. Default 50.
APP_GITHUB_API_DELAY_MS=50

# ------------------------------------------------------------ github oauth
# Callback URL to register on the OAuth App:
#   http://localhost:8080/login/oauth2/code/github
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_SECRET=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_SCOPE=read:user,repo

# --------------------------------------------------------------- anthropic
# Chat model. Get a key from https://console.anthropic.com, ideally scoped to a
# project so you can cap its spend.
SPRING_AI_ANTHROPIC_API_KEY=
SPRING_AI_ANTHROPIC_CHAT_OPTIONS_MODEL=claude-haiku-5-5

# ------------------------------------------------------- embeddings (local)
# Embeddings run locally through ONNX Runtime, so no embedding API key exists.
# Anthropic publishes no embeddings endpoint, which is why these are separate
# providers.
#
# The dimension is fixed once the vector_store table exists: changing the model
# later means dropping the table and re-indexing every repository.
#   all-MiniLM-L6-v2 -> 384
#
# Spring AI defaults the model cache to a fresh OS temp directory per run, so
# the ~90 MB model is re-downloaded on every restart. Pinning it to a stable
# path avoids that: measured locally, it takes a ~44s boot down to ~32s.
#
# On a container platform this path sits in the ephemeral container filesystem,
# so a cold start still re-downloads unless the directory is on a mounted volume.
SPRING_AI_EMBEDDING_TRANSFORMER_CACHE_ENABLED=true
SPRING_AI_EMBEDDING_TRANSFORMER_CACHE_DIRECTORY=${user.home}/.gitquery/model-cache

# --------------------------------------------------------------- pgvector
# Creates the vector_store table on startup if it does not exist.
SPRING_AI_VECTORSTORE_PGVECTOR_INITIALIZE_SCHEMA=true
# Must match the embedding model's output dimension.
SPRING_AI_VECTORSTORE_PGVECTOR_DIMENSIONS=384

# ---------------------------------------------------------------- frontend
# Base URL the browser uses for API calls. Must be reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --------------------------------------------------------- usage allowance
# Per-user included model spend, and the rates it is priced at. Defaults are
# Claude Haiku 5.5 list pricing. Usage is tracked per user in the database; once
# someone reaches the credit, chat requests return 402 without calling the model.
APP_USAGE_INCLUDED_CREDIT_USD=0.05
APP_USAGE_INPUT_USD_PER_MILLION=0.10
APP_USAGE_OUTPUT_USD_PER_MILLION=0.50
